# Copy to `.env` for local development: `cp .env.example .env`
# docker-compose.yml reads these; all have sane defaults for a local skeleton.

# --- Postgres ---
POSTGRES_USER=ctf
POSTGRES_PASSWORD=ctf
POSTGRES_DB=ctf

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Auth ---
# Override with a long random value in any real deployment (ARCHITECTURE.md §7.7).
JWT_SECRET=dev-insecure-secret-change-me-0000000000
