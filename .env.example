# Copy to `.env` and adjust: `cp .env.example .env`
# docker-compose.yml reads these. The defaults run a working stack on
# http://localhost:8080 with no edits; override them for a real deployment.

# --- Public origin / TLS ---
# HTTP_PORT is the host port the app is served on locally (default 8080).
# HTTP_PORT=8080
#
# For a real deployment, set SITE_ADDRESS to your domain and Caddy will obtain
# and renew a TLS certificate automatically; PUBLIC_ORIGIN is the browser-facing
# origin (it's baked into the frontend at build time, so change it via
# `docker compose build`). For local use the defaults are fine.
# SITE_ADDRESS=ctf.example.com
# PUBLIC_ORIGIN=https://ctf.example.com

# --- Postgres ---
POSTGRES_USER=flagpost
POSTGRES_PASSWORD=flagpost
POSTGRES_DB=flagpost

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# The host the browser reaches MinIO on for signed attachment downloads. Local
# default is fine; for a domain, point this at a browser-reachable MinIO host.
# MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- Auth ---
# Leave unset to have the app derive and persist a strong per-install secret
# (stored in the backend-data volume, so it survives restarts). Set a long
# random value explicitly for production, and always for multi-host deployments
# where every replica must share one (ARCHITECTURE.md §7.7; backend/config.py).
# JWT_SECRET=
