# Copy to `.env` and adjust: `cp .env.example .env`
# docker-compose.yml reads these. The defaults run a working stack on
# http://localhost:8080 with no edits; override them for a real deployment.

# --- Public origin / TLS ---
# HTTP_PORT is the host port the app is served on locally (default 8080).
# HTTP_PORT=8080
#
# For a real deployment, set SITE_ADDRESS to your domain and Caddy will obtain
# and renew a TLS certificate automatically; PUBLIC_ORIGIN is the browser-facing
# origin (it's baked into the frontend at build time, so change it via
# `docker compose build`). PUBLIC_ORIGIN also becomes the backend's
# PUBLIC_BASE_URL, which is what OIDC redirect URIs are built from — so it must
# be exact if you configure a single sign-on provider. For local use the
# defaults are fine.
# SITE_ADDRESS=ctf.example.com
# PUBLIC_ORIGIN=https://ctf.example.com

# --- Credentials -------------------------------------------------------------
# Left commented on purpose. Compose falls back to well-known development values
# so `docker compose up` works with no config on a local machine — but those
# values are in this file, in the repo, and in MinIO's own documentation, so
# they are not secrets. Uncomment and set real ones for anything reachable from
# outside your machine. Generate each with:
#
#     openssl rand -hex 24
#
# The backend refuses to start if it finds MinIO's defaults while PUBLIC_ORIGIN
# names a non-local host, because at that point an open object store means every
# challenge attachment — including unreleased ones — is world-readable.
# Changing MINIO_ROOT_* after first boot also needs the minio service recreated;
# they initialise the server, they don't reconfigure it.

# --- Postgres ---
POSTGRES_USER=flagpost
# POSTGRES_PASSWORD=
POSTGRES_DB=flagpost

# --- MinIO (S3-compatible object storage) ---
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# The host the browser reaches MinIO on for signed attachment downloads. Local
# default is fine; for a domain, point this at a browser-reachable MinIO host.
# MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- Demo mode (public demo instances only, e.g. demo.flagpost.io) ---
# When true: seeds public demo accounts (admin / judge / participant, all with
# password "password") + a sample competition, shows a "resets every hour"
# banner, and disables outbound automation actions (webhooks, email). NEVER set
# this on a real deployment — it seeds well-known credentials. Reset the demo by
# recreating the stack on a schedule (`docker compose down -v && docker compose up -d`).
# DEMO_MODE=true

# --- Auth ---
# Leave unset to have the app derive and persist a strong per-install secret
# (stored in the backend-data volume, so it survives restarts). Set a long
# random value explicitly for production, and always for multi-host deployments
# where every replica must share one (ARCHITECTURE.md §7.7; backend/config.py).
# JWT_SECRET=

# --- Update check (PRIVACY.md) ---
# Once a day the backend GETs updates.flagpost.io carrying only its version
# number — it's how administrators learn about a new release, and counting the
# requests is the project's only measure of how many deployments are running.
# Administrators can turn it off in Admin → Site settings. Setting this to an
# empty value disables it outright, so an air-gapped install never attempts the
# call at all.
# UPDATE_CHECK_URL=
