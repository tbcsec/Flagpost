# Copy to `.env` for local development: `cp .env.example .env`
# docker-compose.yml reads these; all have sane defaults for a local skeleton.

# --- Postgres ---
POSTGRES_USER=flagpost
POSTGRES_PASSWORD=flagpost
POSTGRES_DB=flagpost

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Auth ---
# Leave unset to have the app derive and persist a strong per-install secret on
# first boot. Set a long random value explicitly for production and always for
# multi-host deployments, where every replica must share one (ARCHITECTURE.md
# §7.7; backend/config.py).
# JWT_SECRET=
