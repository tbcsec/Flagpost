__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.env
.env.*

# Secrets and local DBs generated by the no-infra dev flow (uvicorn run
# natively in backend/). These are .gitignored, but the Docker build context is
# the working tree, not git — so without excluding them here `COPY . .` would
# bake the live JWT signing secret, the Fernet key that decrypts every
# EncryptedString column, and dev DBs into the published image (GHSA-382m-7xrp-wjq8).
.jwt_secret
.secret_key
*.db
*.sqlite
*.sqlite3
