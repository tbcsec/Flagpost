[Unit]
Description=Reset the Flagpost internal demo on a schedule (hourly by default)

[Timer]
# Default matches the public demo: top of every hour. Change to taste, e.g.
# nightly at 06:00 → OnCalendar=*-*-* 06:00:00
# No Persistent=true: at hourly cadence a boot-time catch-up run would only
# race the stack's own auto-start to perform a reset the next tick repeats
# minutes later. Add it back if you switch to a daily-or-slower cadence.
OnCalendar=*-*-* *:00:00

[Install]
WantedBy=timers.target
